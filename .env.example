# Supabase (src/lib/supabase.ts) — Project Settings → API in the Supabase dashboard.
# The publishable key is meant for the browser; never put the secret/service key here.
VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=
# Set to `off` to run the local demo (no login, localStorage) even with the keys above.
# VITE_BACKEND=off

# Parent progress assistant (src/lib/ai.ts)
# Copy to .env.local (git-ignored) and restart `npm run dev`.
# Without a key the assistant still works: it answers from the report in the
# browser and sends nothing anywhere.

# A free key from https://openrouter.ai/keys
VITE_AI_KEY=

# Optional — any OpenAI-compatible chat endpoint and an open-weights model.
# VITE_AI_ENDPOINT=https://openrouter.ai/api/v1/chat/completions
# VITE_AI_MODEL=meta-llama/llama-3.3-70b-instruct:free
#
# Groq's free tier works the same way:
# VITE_AI_ENDPOINT=https://api.groq.com/openai/v1/chat/completions
# VITE_AI_MODEL=llama-3.3-70b-versatile

# Dev build only: a VITE_ variable is baked into the bundle. Before this ships,
# move the call behind a small proxy that holds the key.

# ---------------------------------------------------------------------------
# Dev only: Admin · Parent · Student as tabs in the top bar (src/lib/devAccounts.ts)
#
# Each line is one test account, as email:password. Fill these in and the app
# opens signed in as the first one, and each tab signs in as the next — the
# whole journey (a family enrols → the admin takes the money and sets the
# week → the hero opens their calendar) without typing a password three times.
#
# Leave them out and the app behaves normally, with the sign-in screen.
# `import.meta.env.DEV` is folded away by the bundler, so none of this — the
# switcher, the auto sign-in, these values — reaches `npm run build`.
#
# VITE_DEV_ADMIN=admin@example.com:the-password
# VITE_DEV_PARENT=parent@example.com:the-password
# VITE_DEV_STUDENT=hero@example.com:the-password
